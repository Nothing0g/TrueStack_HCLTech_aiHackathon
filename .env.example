APP_NAME=TrueStack University Assistant
API_BASE_URL=http://localhost:8000
DATABASE_PATH=storage/university.db
CHROMA_PATH=storage/chroma
DOCUMENTS_PATH=data/documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Keep true for a quick pipeline smoke test. Set false after Ollama/model is running to use real local inference.
MOCK_LLM=true
TOP_K=5
MAX_UPLOAD_MB=100
OCR_ENABLED=true
OCR_MAX_PAGES=12
OCR_DPI=140
